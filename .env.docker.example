# Local Docker Compose configuration only. Copy to .env.docker before starting the stack.
# These values are safe development placeholders and must not be used in production.

# Required Compose service settings
POSTGRES_DB=streamsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-development-password
DATABASE_URL=postgresql://postgres:replace-with-a-local-development-password@postgres:5432/streamsphere
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000

# Optional backend settings
APP_ENV=development
DOCS_ENABLED=true
LOG_LEVEL=INFO
