APP_ENV=development
API_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING_ENABLED=true

POSTGRES_DB=streamsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@postgres:5432/streamsphere

REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CACHE_DEFAULT_TTL_SECONDS=300
RECOMMENDATION_CACHE_TTL_SECONDS=300
AI_SEARCH_CACHE_TTL_SECONDS=600
MOVIE_SUMMARY_CACHE_TTL_SECONDS=3600

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/docs,/redoc,/openapi.json

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

AI_PROVIDER=mock
OPENAI_API_KEY=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://backend:8000
