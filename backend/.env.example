# Backend configuration loaded when the API is started from backend/.
# Copy this file to backend/.env, then replace required placeholders before running locally.

# Required for the local backend
APP_ENV=development
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@127.0.0.1:5432/streamsphere
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional application settings
API_VERSION=1.0.0
DEMO_MODE=false
DEBUG=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING_ENABLED=true
METRICS_ENABLED=true

# Optional Redis and cache settings. Leave Redis disabled when it is not running locally.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
CACHE_DEFAULT_TTL_SECONDS=300
RECOMMENDATION_CACHE_TTL_SECONDS=300
AI_SEARCH_CACHE_TTL_SECONDS=600
MOVIE_SUMMARY_CACHE_TTL_SECONDS=3600

# Optional rate limiting and browser security settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/metrics,/docs,/redoc,/openapi.json
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http: https: ws: wss:;

# Optional authentication settings
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional AI settings. OPENAI_API_KEY is required only when AI_PROVIDER=openai.
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=3
AI_REQUEST_RETRIES=1
