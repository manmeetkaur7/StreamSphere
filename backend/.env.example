# Application
APP_ENV=development
API_VERSION=1.0.0
DEBUG=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
STRUCTURED_LOGGING_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/streamsphere

# Redis
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
CACHE_DEFAULT_TTL_SECONDS=300
RECOMMENDATION_CACHE_TTL_SECONDS=300
AI_SEARCH_CACHE_TTL_SECONDS=600
MOVIE_SUMMARY_CACHE_TTL_SECONDS=3600
METRICS_ENABLED=true

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_EXEMPT_PATHS=/health,/metrics,/docs,/redoc,/openapi.json

# Authentication
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI
AI_PROVIDER=mock
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=3
AI_REQUEST_RETRIES=1
SECURITY_HEADERS_ENABLED=true
CONTENT_SECURITY_POLICY=default-src 'self'; img-src 'self' https: data:; media-src 'self' https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' http: https: ws: wss:;
